{
  "name": "@jeffeek/connpool",
  "version": "1.0.16",
  "description": "A battle-tested async connection-pool model — slot-reserved sizing, health & rotation, a circuit breaker, backoff retries, and first-class observability. Zero runtime dependencies.",
  "keywords": [
    "connection-pool",
    "pool",
    "async",
    "circuit-breaker",
    "retry",
    "resource-pool",
    "backpressure"
  ],
  "homepage": "https://github.com/Jeffeek/poolyglot/tree/main/typescript#readme",
  "bugs": "https://github.com/Jeffeek/poolyglot/issues",
  "license": "MIT",
  "author": "Jeffeek",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jeffeek/poolyglot.git",
    "directory": "typescript"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node scripts/make-cts-dts.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint ./src ./test",
    "lint:fix": "biome lint --write ./src ./test",
    "format": "biome format --write ./src ./test",
    "format:check": "biome format ./src ./test",
    "test": "bash run_tests.sh",
    "fuzz": "tsx fuzz/async-primitives.fuzz.ts",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^26.6.5",
    "c8": "^12.0.0",
    "fast-check": "^4.10.2",
    "tsup": "^9.0.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
