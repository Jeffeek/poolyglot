<Project Sdk="Microsoft.NET.Sdk">

  <!-- SharpFuzz (libFuzzer bridge) harness for the AsyncConnectionPool / AsyncCondition /
       AwaitShielded cancellation path (Pools/AsyncPrimitives.cs). Deliberately OUTSIDE
       ConnPool.sln so `dotnet test ConnPool.sln` / run_tests.sh's coverlet 100% line+branch
       gate never builds or measures it (same treatment as ../../examples).

       SharpFuzz needs libFuzzer-style byte-level instrumentation (via the `sharpfuzz` CLI
       post-build step), which only works end-to-end on a clang/Linux host. See README.md in
       this directory for the manual run steps. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpFuzz" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ConnPool\ConnPool.csproj" />
  </ItemGroup>

</Project>
