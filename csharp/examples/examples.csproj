<Project Sdk="Microsoft.NET.Sdk">

  <!-- Example / client code: NOT part of the ConnPool package. It may take dependencies
       (here Microsoft.Data.Sqlite) that the library itself never does. Kept out of
       ConnPool.sln so the test/coverage run never builds it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\ConnPool\ConnPool.csproj" />
  </ItemGroup>

</Project>
